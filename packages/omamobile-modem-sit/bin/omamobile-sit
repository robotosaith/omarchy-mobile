#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""omamobile-sit: calls, SMS and status through omamobile-sitd's socket.

  omamobile-sit [--sim 1|2] COMMAND    SIM 1 by default (dial: the calls SIM,
                                       sms send: the texts SIM); SIM 2 is the
                                       second sitd (omamobile-sitd-2.service)
  omamobile-sit sims [--json]          both SIMs and which does data, calls, texts
  omamobile-sit sims set data|calls|texts 1|2
                                       make a SIM the default (data restarts both
                                       SIM services, about 30 s)

  omamobile-sit status [--json]        registration, IMS voice/SMS, data, calls
  omamobile-sit watch                  the public status, one JSON line per change
  omamobile-sit dial NUMBER            a voice call (international form; CS with ims = no)
  omamobile-sit answer [ID]            the ringing call (or call ID)
  omamobile-sit hangup [ID]            the current call (or call ID)
  omamobile-sit dtmf KEYS [ID]         touch tones in the active call
  omamobile-sit mute on|off            the microphone during a call
  omamobile-sit sms send NUMBER TEXT   one SMS (several parts if needed)
  omamobile-sit sms list [--json]      received, not yet deleted
  omamobile-sit sms delete ID
  omamobile-sit data on|off            the cellular fallback route (rmnet0)
  omamobile-sit sim-pin [--last-try] [--stdin]
                                       unlock the SIM (asks for its PIN, or reads
                                       it from stdin with --stdin; with one
                                       try left only with --last-try)
  omamobile-sit radio on|off           AT+CFUN 1/0 (registration and bearers go
                                       with "off"; a restart needs a reboot)

Root and members of the [control] group (/etc/omamobile/modem-sit.conf,
default wheel) may use it; "watch" and "status --json" fall back to the
world-readable /run/omamobile-sit/state.json.
"""
import json
import os
import socket
import subprocess
import sys
import time
import uuid

SIMS_CONF = os.environ.get('OMAMOBILE_SIMS_CONF', '/etc/omamobile/sims.conf')


def defaults():
    """Which SIM does data, calls and texts (/etc/omamobile/sims.conf,
    written by omamobile-sims-set); SIM 1 for anything not set."""
    import configparser
    parser = configparser.ConfigParser(interpolation=None)
    parser.read(SIMS_CONF)
    return {k: parser.get('default', k, fallback='1') for k in ('data', 'calls', 'texts')}


# --sim N (first) picks the sitd instance; SIM 2's files end in "-2"
# (omamobile-sitd-2.service). Without it, dial uses the calls SIM, sms send
# the texts SIM, everything else SIM 1.
SIM = os.environ.get('OMAMOBILE_SIT_SIM', '')
if len(sys.argv) > 2 and sys.argv[1] == '--sim':
    SIM = sys.argv[2]
    del sys.argv[1:3]
if not SIM:
    if sys.argv[1:2] == ['dial']:
        SIM = defaults()['calls']
    elif sys.argv[1:3] == ['sms', 'send']:
        SIM = defaults()['texts']
    else:
        SIM = '1'
if SIM not in ('1', '2'):
    sys.exit('omamobile-sit: --sim is 1 or 2')
RUN = os.environ.get('OMAMOBILE_SIT_RUN', '/run/omamobile-sit' + ('' if SIM == '1' else '-' + SIM))


def request(action, timeout=25, **args):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(timeout)
        client.connect(os.path.join(RUN, 'socket'))
        client.sendall(json.dumps(dict(action=action, **args)).encode() + b'\n')
        data = b''
        while b'\n' not in data:
            chunk = client.recv(65536)
            if not chunk:
                raise RuntimeError('omamobile-sitd disconnected')
            data += chunk
    reply = json.loads(data)
    if not reply.get('ok'):
        raise RuntimeError(reply.get('error') or 'request failed')
    return reply['result']


def public_state():
    try:
        with open(os.path.join(RUN, 'state.json')) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def live_call(state, wanted=('ringing-in', 'waiting', 'active', 'dialing', 'ringing-out', 'held')):
    for call in state['calls']:
        if call['state'] in wanted:
            return call['id']
    raise RuntimeError('no such call')


def show(status):
    m = status['modem']
    sim = m.get('sim') or {}
    print(f"SIM: {sim.get('label', 'SIM ' + SIM)}, {sim.get('state', 'unknown')}")
    print(f"stage: {m.get('stage')}")
    print(f"network: {m.get('registration')} {m.get('tech')} {m.get('operator')}".rstrip())
    print(f"IMS voice: {'yes' if m.get('voice') else 'no'}, SMS: {'yes' if m.get('sms') else 'no'}, "
          f"data bearer: {'up' if m.get('data') else 'down'}")
    for call in status.get('calls', []):
        print(f"call {call.get('id', '')}: {call['direction']} {call['state']}")


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    try:
        if cmd == 'status':
            try:
                status = request('status')
            except (OSError, RuntimeError):
                status = public_state()
                if status is None:
                    print(json.dumps({'daemon': 'absent'}) if '--json' in rest else 'omamobile-sitd is not running')
                    return 1
            if '--json' in rest:
                print(json.dumps(status))
            else:
                show(status)
            return 0
        if cmd == 'watch':
            last = None
            while True:
                state = public_state() or {'daemon': 'absent'}
                compare = {k: v for k, v in state.items() if k != 'updated'}
                if compare != last:
                    print(json.dumps(state), flush=True)
                    last = compare
                time.sleep(1)
        if cmd == 'dial' and len(rest) == 1:
            print(request('dial', number=rest[0])['call'])
            return 0
        if cmd in ('answer', 'hangup') and len(rest) <= 1:
            ident = rest[0] if rest else live_call(request('status'), ('ringing-in', 'waiting') if cmd == 'answer'
                                                     else ('ringing-in', 'waiting', 'active', 'dialing', 'ringing-out', 'held'))
            request('accept' if cmd == 'answer' else 'hangup', id=ident)
            return 0
        if cmd == 'dtmf' and 1 <= len(rest) <= 2:
            ident = rest[1] if len(rest) == 2 else live_call(request('status'), ('active',))
            request('dtmf', id=ident, keys=rest[0])
            return 0
        if cmd == 'mute' and rest in (['on'], ['off']):
            request('audio', what='mute', value=rest[0])
            return 0
        if cmd == 'sms' and rest[:1] == ['send'] and len(rest) == 3:
            key = uuid.uuid4().hex
            result = request('sms-send', timeout=300, request_id=key, number=rest[1], text=rest[2])
            print(result['state'] + (': ' + result['error'] if result.get('error') else ''))
            return 0 if result['state'] == 'sent' else 1
        if cmd == 'sms' and rest[:1] == ['list']:
            messages = request('sms-list')
            if '--json' in rest:
                print(json.dumps(messages))
            for m in messages if '--json' not in rest else []:
                print(f"{m['id']}  {m['timestamp']}  {m['number']}\n  {m['text']}")
            return 0
        if cmd == 'sms' and rest[:1] == ['delete'] and len(rest) == 2:
            request('sms-delete', id=rest[1])
            return 0
        if cmd == 'radio' and rest in (['on'], ['off']):
            print(request('radio', timeout=60, on=rest[0] == 'on')['radio'])
            return 0
        if cmd == 'sim-pin' and '--stdin' in rest and set(rest) <= {'--stdin', '--last-try'}:
            # For the shell's SIM sheet: the PIN on stdin (never argv), no
            # prompts; one line out: "unlocked", or the state or error.
            pin = sys.stdin.readline().strip()
            sim = request('sim-pin', timeout=30, pin=pin, last_try='--last-try' in rest)['sim']
            print('unlocked' if sim.get('state') == 'ready' else sim.get('state', 'unknown'))
            return 0 if sim.get('state') == 'ready' else 1
        if cmd == 'sim-pin' and rest in ([], ['--last-try']):
            # The PIN shows as it is typed (a phone keyboard is easy to
            # mistype on), and nothing goes to the SIM until it is confirmed.
            sim = request('status')['modem'].get('sim') or {}
            if sim.get('state') != 'pin':
                print('The SIM is not asking for its PIN (state: %s)' % sim.get('state', 'unknown'))
                return 1
            print('PIN tries left:', sim.get('pin_retries', '?'))
            pin = input('SIM PIN (shown): ').strip()
            if input('Send %s to the SIM? Type yes: ' % pin).strip().lower() != 'yes':
                print('Nothing sent')
                return 1
            sim = request('sim-pin', timeout=30, pin=pin, last_try=bool(rest))['sim']
            print('SIM unlocked' if sim.get('state') == 'ready' else 'SIM state: ' + sim.get('state', 'unknown'))
            return 0
        if cmd == 'sims' and rest in ([], ['--json']):
            chosen = defaults()
            sims = []
            for n in ('1', '2'):
                path = '/run/omamobile-sit' + ('' if n == '1' else '-' + n)
                try:
                    with open(os.path.join(path, 'state.json')) as f:
                        m = json.load(f).get('modem') or {}
                except (OSError, ValueError):
                    m = None
                if m is None and not os.path.exists('/etc/omamobile/modem-sit' + ('' if n == '1' else '-' + n) + '.conf'):
                    continue
                m = m or {}
                sim = m.get('sim') or {}
                sims.append(dict(number=int(n), label=sim.get('label') or 'SIM ' + n,
                                 state=sim.get('state', 'off' if not m else 'unknown'),
                                 stage=m.get('stage', 'off'), operator=m.get('operator', ''),
                                 tech=m.get('tech', ''), registration=m.get('registration', ''),
                                 data=chosen['data'] == n, calls=chosen['calls'] == n, texts=chosen['texts'] == n))
            if '--json' in rest:
                print(json.dumps(dict(sims=sims, defaults={k: int(v) for k, v in chosen.items()})))
            else:
                for s in sims:
                    roles = ', '.join(k for k in ('data', 'calls', 'texts') if s[k]) or '-'
                    print(f"{s['label']}: {s['state']}, {s['registration'] or s['stage']} {s['tech']}".rstrip()
                          + f"  [{roles}]")
            return 0
        if cmd == 'sims' and len(rest) == 3 and rest[0] == 'set' and rest[1] in ('data', 'calls', 'texts') \
                and rest[2] in ('1', '2'):
            unit = f'omamobile-sims-set@{rest[1]}-{rest[2]}.service'
            return subprocess.run(['systemctl', 'start', unit]).returncode
        if cmd == 'data' and rest in (['on'], ['off']):
            verb = 'start' if rest[0] == 'on' else 'stop'
            return subprocess.run(['systemctl', verb, 'omamobile-sit-data.service']).returncode
    except (OSError, RuntimeError, ValueError) as error:
        print('omamobile-sit:', error, file=sys.stderr)
        return 1
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
