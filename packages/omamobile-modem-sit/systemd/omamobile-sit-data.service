# SPDX-License-Identifier: MIT
# The cellular fallback: rmnet0's address, a metric-700 default route behind
# Wi-Fi, and the carrier's DNS while cellular is the only way out. Started
# after omamobile-sitd is ready (it set up the internet bearer);
# "omamobile-sit data on|off" starts and stops it.
[Unit]
Description=Omarchy Mobile cellular data fallback (rmnet0)
# The data SIM's sitd (/etc/omamobile/sims.conf): either.
After=omamobile-sitd.service omamobile-sitd-2.service

[Service]
ExecStart=/usr/bin/omamobile-sit-data
# Remembered across reboots (omamobile-sit-data-restore.service): on when
# started, off when stopped by the owner, kept when stopped by a shutdown.
ExecStartPost=/usr/bin/touch /var/lib/omamobile-sit/data-on
# Only a clean stop outside shutdown (the owner's "data off") forgets it; a
# failure (no bearer yet at boot, or a bearer renewal) keeps it.
ExecStopPost=/bin/sh -c '[ "$SERVICE_RESULT" = success ] || exit 0; systemctl is-system-running | grep -qx stopping || rm -f /var/lib/omamobile-sit/data-on'
Restart=on-failure
RestartSec=10
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=omamobile-sitd.service
