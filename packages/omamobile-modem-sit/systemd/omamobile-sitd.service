# SPDX-License-Identifier: MIT
# The SIT RIL: registers a freshly booted CP (SIM, attach APN, LTE, internet
# bearer, IMS) and then serves calls and SMS on /run/omamobile-sit/socket.
# Not enabled by the package: MODEM-PLAN.md M4 enables it after the gated
# first runs. It needs the modem unit's CP ONLINE and never restarts on its
# own: a second start-up on the same CP is not supported (reboot instead).
[Unit]
Description=Omarchy Mobile SIT RIL (S5300 calls, SMS, registration)
Requires=omamobile-modem.service
After=omamobile-modem.service omamobile-audio.service
# Nothing to serve on a phone without the modem's vendor files (provisioning).
ConditionPathExists=/usr/lib/omamobile-vendor/modem/root

[Service]
Type=notify
NotifyAccess=main
# CPIF's channels appear just after the modem unit reports ONLINE.
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do [ -e /dev/umts_ipc0 ] && exit 0; sleep .5; done; echo "no CPIF channel" >&2; exit 1'
ExecStart=/usr/bin/omamobile-sitd --bringup
Restart=no
# Start-up waits for the SIM's PIN (omamobile-sit sim-pin) as long as it
# takes; SIM, registration and IMS can take minutes on a fresh CP.
TimeoutStartSec=infinity
# Time to hang up a call and restore the audio routes.
TimeoutStopSec=60
RuntimeDirectory=omamobile-sit
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=omamobile-sit
StateDirectoryMode=0700
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
