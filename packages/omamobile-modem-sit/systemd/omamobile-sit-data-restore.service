# Mobile data back on after a reboot if the owner left it on
# (omamobile-sit-data.service keeps /var/lib/omamobile-sit/data-on). A
# device package enables it. The data service retries until the data SIM's
# bearer is up.
[Unit]
Description=Omarchy Mobile: mobile data back on if it was on
ConditionPathExists=/var/lib/omamobile-sit/data-on
After=omamobile-sitd.service omamobile-sitd-2.service

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl start --no-block omamobile-sit-data.service

[Install]
WantedBy=multi-user.target
