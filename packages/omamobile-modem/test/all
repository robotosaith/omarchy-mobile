#!/bin/bash
# SPDX-License-Identifier: MIT
# Offline tests for omamobile-modem: syntax, the CP helper's file parsers on
# made-up inputs (a TOC, NV files), the staged layout and the unit. Nothing
# here touches a modem, a partition or /dev.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
export PYTHONDONTWRITEBYTECODE=1
cp=lib/omamobile-modem-cp

bash -n install && bash -n lib/omamobile-modem-start && bash -n profiles/modem.conf || fail "shell syntax"
python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' "$cp" || fail "$cp parses"
if command -v shellcheck >/dev/null; then
  shellcheck -S warning lib/omamobile-modem-start install || fail "shellcheck"
fi
pass "scripts parse"

t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
# A made-up modem.bin: TOC, BOOT, INFO entries (32 bytes each; the TOC
# entry's last word is the last entry's index), the version 20 bytes into
# INFO. A 31-character version is cut at 31 bytes, as rfsd reads it.
python3 - "$t" <<'PY'
import struct, sys
def image(path, version, entries=((b'BOOT', 0x200, 0x100), (b'INFO', 0x300, 0x80))):
    toc = b'TOC'.ljust(12, b'\0') + struct.pack('<5I', 0, 0, 0x200, 0, len(entries) - 1)
    for name, off, size in entries:
        toc += name.ljust(12, b'\0') + struct.pack('<5I', off, 0, size, 0, 0)
    data = bytearray(0x400); data[:len(toc)] = toc
    data[0x300 + 20:0x300 + 20 + len(version)] = version
    open(path, 'wb').write(data)
image(sys.argv[1] + '/modem.bin', b'test-version-001')
image(sys.argv[1] + '/long.bin', b'v' * 31 + b'XYZ')
image(sys.argv[1] + '/noinfo.bin', b'', ((b'BOOT', 0x200, 0x100), (b'MAIN', 0x300, 0x80)))
PY
[[ $(python3 "$cp" baseband-version "$t/modem.bin") == test-version-001 ]] || fail "baseband version from a TOC"
[[ $(python3 "$cp" baseband-version "$t/long.bin") == "$(printf 'v%.0s' {1..31})" ]] || fail "version cut at 31 bytes"
python3 "$cp" baseband-version "$t/noinfo.bin" 2>/dev/null && fail "a TOC without INFO is refused"
# a raw modem partition starts with a tar header, not a TOC
{ printf 'test-version-001'; head -c 496 /dev/zero; } > "$t/notoc.bin"
python3 "$cp" baseband-version "$t/notoc.bin" 2>/dev/null && fail "a file without a TOC is refused"
pass "baseband version"

mkdir -p "$t/efs" "$t/efs_backup"
for f in efs/nv_normal.bin efs/nv_protected.bin efs_backup/nv_protected.bak; do
  printf 'made-up %s' "$f" > "$t/$f"
  python3 -c 'import hashlib,sys; d=open(sys.argv[1],"rb").read(); open(sys.argv[1]+".md5","wb").write(hashlib.md5(d+b"Samsung_SIT_RIL").hexdigest().encode())' "$t/$f"
done
python3 "$cp" nv-check "$t/efs" "$t/efs_backup" 2>/dev/null || fail "matching NV checksums pass"
printf 'x' >> "$t/efs/nv_normal.bin"
python3 "$cp" nv-check "$t/efs" "$t/efs_backup" 2>/dev/null && fail "a changed NV file is refused"
pass "NV checksums"

stage=$t/stage
./install "$stage"
for f in usr/lib/omamobile-vendor/omamobile-modem-start usr/lib/omamobile-vendor/omamobile-modem-cp \
         usr/lib/omamobile-vendor/profiles/modem.conf usr/lib/omamobile-vendor/modem/props.conf \
         usr/lib/systemd/system/omamobile-modem.service usr/lib/udev/rules.d/60-omamobile-modem-nv-ro.rules; do
  [[ -e $stage/$f ]] || fail "staged $f"
done
grep -qx 'persist.vendor.modem.efs.clear.action=none' modem/props.conf ||
  fail "efs.clear.action is pinned to none (empty clears NV)"
grep -qx 'vendor.modem.bin.path=/mnt/vendor/modem_img/images/default/modem.bin' modem/props.conf ||
  fail "rfsd reads its TOC from the firmware file (vendor.modem.bin.path)"
if command -v systemd-analyze >/dev/null; then
  systemd-analyze verify --man=no "$stage/usr/lib/systemd/system/omamobile-modem.service" 2>&1 |
    grep -v -e 'not executable' -e 'No such file' -e 'omamobile-aoc.service' -e 'omamobile-audio.service' -e '^$' &&
    fail "unit verify" || true
fi
pass "staged layout, props and unit"

# cbd_watch stops a retrying cbd after its first failed boot (M3.4.5: cbd
# powered the modem on 15 times in 80 s). A fake cbd fails every attempt.
out=$(RUN=$t CBD_ATTEMPTS=1 bash -c '
  say() { printf "omamobile-modem: %s\n" "$*"; }
  eval "$(sed -n "/^cbd_watch() {/,/^}/p" profiles/modem.conf)"
  fake="while :; do echo \"I -[1]: Power on CP\"; sleep 0.1
    echo \"E -[1]: ERR! IOCTL_START_CP_BOOTLOADER fail\"; echo \"I -[1]: start boot fail\"; done"
  sh -c "echo \$\$ > \"\$0\"; exec \"\$@\"" "$RUN/cbd.pid" timeout 10 sh -c "$fake" 2>&1 | cbd_watch
  echo "rc=${PIPESTATUS[0]}"' 2>&1)
[[ $(grep -c 'Power on CP' <<<"$out") -le 2 && $out == *"1 failed boot attempt(s)"* && $out == *rc=143* ]] ||
  fail "cbd stopped after one failed boot: $out"
[[ ! -e $t/cbd.pid ]] || fail "cbd pid file removed"
pass "cbd stopped after its first failed boot"

# The board id is required (M4.1g/h): the check refuses a missing or empty
# ro.boot.cdt_hwid and a persist copy that differs. Made-up values only.
cdt() { bash -c 'say() { :; }; eval "$(sed -n "/^modem_cdt_check() {/,/^}/p" profiles/modem.conf)"; modem_cdt_check "$1"' _ "$1"; }
: > "$t/p0"; cdt "$t/p0" && fail "no props file content is refused"
printf 'ro.boot.cdt_hwid=\n' > "$t/p1"; cdt "$t/p1" && fail "an empty board id is refused"
printf 'ro.boot.cdt_hwid=TESTID\npersist.vendor.modem.cdt_hwid=OTHER\n' > "$t/p2"; cdt "$t/p2" && fail "a differing persist copy is refused"
printf 'ro.boot.cdt_hwid=TESTID\npersist.vendor.modem.cdt_hwid=TESTID\n' > "$t/p3"; cdt "$t/p3" || fail "a board id is accepted"
printf 'ro.boot.cdt_hwid=TESTID\n' > "$t/p4"; cdt "$t/p4" || fail "the persist copy is optional"
cdt "$t/missing" && fail "a missing props file is refused"
pass "board id required"

# The crash record's kernel lines: the modem's lines only, without this
# tool's own umts_boot0 opens, and a flood folded into one line and a count
python3 - "$cp" <<'PY' || fail "crash record folds a repeated kernel line"
import importlib.machinery, importlib.util, sys
loader = importlib.machinery.SourceFileLoader('cp', sys.argv[1])
cp = importlib.util.module_from_spec(importlib.util.spec_from_loader('cp', loader))
loader.exec_module(cp)
log = ['[1.0] gs201-pcie-cp 11920000.pcie: link-down recovery requested',
       '[1.1] wlan: unrelated']
log += [f'[2.{i}] cpif: s51xx_pcie_send_doorbell_int: cmd reg = 0xffff' for i in range(5000)]
log += ['[3.0] cpif: bootdump_open: umts_boot0 (opened 2) by python3',
        '[3.1] cpif: link down for 5000 ms and recovery did not clear it: force crash']
out = cp.kernel_lines(log)
assert out == [log[0], log[2], '    (repeated 4999 more times)', log[-1]], out
assert len(cp.kernel_lines(log[2:3] * 3 + [f'[4.{i}] cpif: x{i}' for i in range(300)])) == 150
PY
pass "crash record folds a repeated kernel line"

# The hang marker: a clean stop in the same boot removes it; a marker from
# another boot (a hang or reset there) stays, and the start refuses
m=$t/mark
printf '2026-10-21T08:18:10+01:00 boot aaaa\n' > "$m"
OMAMOBILE_MODEM_MARK_FILE=$m OMAMOBILE_BOOT_ID=aaaa bash lib/omamobile-modem-start --stopped 2>/dev/null
[[ ! -e $m ]] || fail "a clean stop removes this boot's marker"
printf '2026-10-21T08:18:10+01:00 boot aaaa\n' > "$m"
OMAMOBILE_MODEM_MARK_FILE=$m OMAMOBILE_BOOT_ID=bbbb bash lib/omamobile-modem-start --stopped 2>/dev/null
[[ -e $m ]] || fail "a marker from another boot stays"
OMAMOBILE_MODEM_MARK_FILE=$m OMAMOBILE_BOOT_ID=bbbb bash lib/omamobile-modem-start 2>/dev/null && fail "a marker from another boot blocks the start"
OMAMOBILE_MODEM_MARK_FILE=$t/none OMAMOBILE_BOOT_ID=aaaa bash lib/omamobile-modem-start --stopped 2>/dev/null || fail "--stopped without a marker"
grep -qx 'ExecStopPost=/usr/lib/omamobile-vendor/omamobile-modem-start --stopped' systemd/omamobile-modem.service || fail "the unit drops the marker on a clean stop"
pass "hang marker survives only a hang"
